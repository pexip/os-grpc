#!/usr/bin/make -f
# -*- makefile -*-

# Uncomment this to turn on verbose mode.
#export DH_VERBOSE=1

export DEB_HOST_MULTIARCH ?= $(shell dpkg-architecture -qDEB_HOST_MULTIARCH)

# Reduce debug info to workaround address space limitation
ifneq (,$(filter $(DEB_HOST_ARCH), mipsel))
    export DEB_CXXFLAGS_MAINT_APPEND += -g1
endif

# Python building should use system libraries
export GRPC_BUILD_WITH_BORING_SSL_ASM = 0
export GRPC_PYTHON_BUILD_WITH_CYTHON = 1
export GRPC_PYTHON_BUILD_SYSTEM_OPENSSL = 1
export GRPC_PYTHON_BUILD_SYSTEM_ZLIB = 1
export GRPC_PYTHON_BUILD_SYSTEM_CARES = 1
export GRPC_PYTHON_BUILD_SYSTEM_RE2 = 1
export GRPC_PYTHON_ENABLE_DOCUMENTATION_BUILD = 1

# Ruby
#export GEM2DEB_TEST_RUNNER = --check-dependencies
#export DH_RUBY = --gem-install
#export DH_RUBY_GEM_INSTALL_INCLUDE = platform_check.rb version.rb

#export DH_RUBY_IGNORE_TESTS = all

BUILD_STATIC_DIR=$(CURDIR)/build-static/
BUILD_SHARED_DIR=$(CURDIR)/build-shared/

# Figure out where our python build is going
PYTHON_VERSION=$(shell python3 -c "import sys; print('.'.join(map(str, sys.version_info[0:2])))")
PYTHON_TMP_DIR=$(CURDIR)/debian/tmp-python
PYTHON_TMP_DIR_PYPATH=$(PYTHON_TMP_DIR)/usr/lib/python$(PYTHON_VERSION)/dist-packages

# -DCMAKE_BUILD_TYPE=Release
COMMON_BUILD_FLAGS= \
	-DgRPC_DOWNLOAD_ARCHIVES=OFF \
	-DgRPC_ABSL_PROVIDER=package \
	-DgRPC_CARES_PROVIDER=package \
	-DgRPC_BENCHMARK_PROVIDER=package \
	-DgRPC_PROTOBUF_PROVIDER=package \
	-DgRPC_RE2_PROVIDER=package \
	-DgRPC_SSL_PROVIDER=package \
	-DgRPC_ZLIB_PROVIDER=package \
	-DgRPC_BACKWARDS_COMPATIBILITY_MODE=OFF \
	-DgRPC_INSTALL_LIBDIR=lib/$(DEB_HOST_MULTIARCH) \
	-DgRPC_INSTALL_CMAKEDIR=lib/$(DEB_HOST_MULTIARCH)/cmake/grpc \
	-DgRPC_INSTALL_PKGCONFIGDIR=lib/$(DEB_HOST_MULTIARCH)/pkgconfig \
	-DgRPC_BUILD_GRPC_CPP_PLUGIN=ON \
	-DgRPC_BUILD_GRPC_CSHARP_PLUGIN=OFF \
	-DgRPC_BUILD_GRPC_NODE_PLUGIN=OFF \
	-DgRPC_BUILD_GRPC_OBJECTIVE_C_PLUGIN=OFF \
	-DgRPC_BUILD_GRPC_PHP_PLUGIN=ON \
	-DgRPC_BUILD_GRPC_PYTHON_PLUGIN=ON \
	-DgRPC_BUILD_GRPC_RUBY_PLUGIN=OFF \
	-DgRPC_DOWNLOAD_ARCHIVES=OFF

export V=1

override_dh_auto_clean:
	$(RM) -r $(BUILD_STATIC_DIR)
	rm -fr $(PYTHON_TMP_DIR)
	dh_auto_clean -O--buildsystem=cmake \
		-O--builddir=$(BUILD_SHARED_DIR)
	PYBUILD_NAME=grpcio dh_auto_clean -O--buildsystem=pybuild
	$(RM) $(CURDIR)/src/python/grpcio/grpc/_cython/cygrpc.*.so
	$(RM) -r $(CURDIR)/__pycache__/ \
		$(CURDIR)/src/python/grpcio/__pycache__/ \
		$(CURDIR)/python_build/ \
		$(CURDIR)/.pybuild/ \
		$(CURDIR)/src/python/grpcio/grpcio.egg-info/
	$(RM) $(CURDIR)/a.out

override_dh_auto_configure:
	mkdir -p $(CURDIR)/third_party/googletest/
	ln -s /usr/src/googletest/googlemock/ \
		$(CURDIR)/third_party/googletest/
	ln -s /usr/src/googletest/googletest/ \
		$(CURDIR)/third_party/googletest/

	dh_auto_configure -O--buildsystem=cmake \
		-O--builddir=$(BUILD_STATIC_DIR) -- \
		-DBUILD_SHARED_LIBS=OFF \
		-DgRPC_BUILD_TESTS=OFF \
		$(COMMON_BUILD_FLAGS)

	dh_auto_configure -O--buildsystem=cmake \
		-O--builddir=$(BUILD_SHARED_DIR) -- \
		-DBUILD_SHARED_LIBS=ON \
		-DgRPC_BUILD_TESTS=OFF \
		$(COMMON_BUILD_FLAGS)

	PYBUILD_NAME=grpcio dh_auto_configure -O--buildsystem=pybuild
	PYBUILD_NAME=grpcio-tools PYBUILD_DIR=tools/distrib/python/grpcio_tools dh_auto_configure -O--buildsystem=pybuild

override_dh_auto_build:
	dh_auto_build -O--buildsystem=cmake \
		-O--builddir=$(BUILD_STATIC_DIR)
	dh_auto_build -O--buildsystem=cmake \
		-O--builddir=$(BUILD_SHARED_DIR)

	# Main grpio python tooling
	PYBUILD_NAME=grpcio \
		dh_auto_build -O--buildsystem=pybuild

	# Use the pydistutils config which PYBUILD creates in its directory to install to
	# a temporary location so that other builds can reference this
	HOME=$(CURDIR)/.pybuild/cpython3_$(PYTHON_VERSION)_grpcio \
	     python$(PYTHON_VERSION) setup.py install --root $(PYTHON_TMP_DIR)

	# Handle grpcio-tools as we need it to build other things
	# Need to build and install grpcio-tools before things which depend on
	# it can be configured / built / installed

	# This assumes that the GRPC source is available in grpc_root which doesn't exist,
	# so create a symlink
	ln -sfn ../../../../ tools/distrib/python/grpcio_tools/grpc_root
	PYBUILD_NAME=grpcio-tools PYBUILD_DIR=tools/distrib/python/grpcio_tools \
		dh_auto_build -O--buildsystem=pybuild

	# Same as above, install into a temporary location so we can work with this
	cd tools/distrib/python/grpcio_tools && HOME=$(CURDIR)/.pybuild/cpython3_$(PYTHON_VERSION)_grpcio-tools \
		python$(PYTHON_VERSION) setup.py install --root $(PYTHON_TMP_DIR)

	# Build python binding packages in specified order
	for package in reflection observability status channelz health_checking testing; do \
		ln -sfn ../../.. src/python/grpcio_$$package/grpc_root ; \
		GRPC_PYTHON_LDFLAGS="-L$(CURDIR)/build-shared -lgrpc" \
		PYTHONPATH=$(PYTHON_TMP_DIR_PYPATH) \
		PYBUILD_NAME=grpcio_$$package \
		PYBUILD_DIR=src/python/grpcio_$$package \
			dh_auto_configure -O--buildsystem=pybuild ; \
		\
		GRPC_PYTHON_LDFLAGS="-L$(CURDIR)/build-shared -lgrpc" \
		PYTHONPATH=$(PYTHON_TMP_DIR_PYPATH) \
		PYBUILD_NAME=grpcio_$$package \
		PYBUILD_DIR=src/python/grpcio_$$package \
			dh_auto_build -O--buildsystem=pybuild ; \
		\
		cd src/python/grpcio_$$package && HOME=$(CURDIR)/.pybuild/cpython3_$(PYTHON_VERSION)_grpcio_$$package \
			python$(PYTHON_VERSION) setup.py install --root $(PYTHON_TMP_DIR) && cd $(CURDIR) ; \
	done

	# dh_auto_build -O--buildsystem=ruby

override_dh_auto_install:
	dh_auto_install -O--buildsystem=cmake \
		-O--builddir=$(BUILD_STATIC_DIR)
	dh_auto_install -O--buildsystem=cmake \
		-O--builddir=$(BUILD_SHARED_DIR)

	#dh_auto_install -O--buildsystem=pybuild
	#TOPDIR=$(CURDIR)/debian/tmp/usr/lib/$(DEB_HOST_MULTIARCH) \
	#	dh_auto_install -O--buildsystem=ruby

	PYBUILD_NAME=grpcio \
		dh_auto_install -O--buildsystem=pybuild

	PYBUILD_NAME=grpcio-tools PYBUILD_DIR=tools/distrib/python/grpcio_tools \
		dh_auto_install -O--buildsystem=pybuild

	for package in reflection observability status channelz health_checking testing; do \
		PYTHONPATH=$(PYTHON_TMP_DIR_PYPATH) PYBUILD_NAME=grpcio_$$package PYBUILD_DIR=src/python/grpcio_$$package \
			dh_auto_install -O--buildsystem=pybuild ; \
	done

	# We currently don't ship this
	rm -f debian/tmp/usr/lib/$(DEB_HOST_MULTIARCH)/pkgconfig/grpcpp_otel_plugin.pc

%:
	dh $@ --builddir=$(BUILD_SHARED_DIR) --buildsystem=cmake \
		--with=python3

override_dh_gencontrol:
	dh_gencontrol

.PHONY: overide_dh_auto_clean override_dh_auto_configure \
	override_dh_auto_build override_dh_auto_install \
	override_dh_gencontrol

@@ -0,0 +1,135 @@
+syntax = "proto3";
+
+package envoy.admin.v3;
+
+import "envoy/admin/v3/config_dump_shared.proto";
+import "envoy/config/bootstrap/v3/bootstrap.proto";
+
+import "google/protobuf/any.proto";

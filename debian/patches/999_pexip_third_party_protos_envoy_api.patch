+  // if that is set. If it isn't, ZooKeeper's default is also 1Mb.
+  google.protobuf.UInt32Value max_packet_bytes = 3;
+}
diff --git a/third_party/envoy-api/envoy/config/filter/thrift/rate_limit/v2alpha1/rate_limit.proto b/third_party/envoy-api/envoy/config/filter/thrift/rate_limit/v2alpha1/rate_limit.proto

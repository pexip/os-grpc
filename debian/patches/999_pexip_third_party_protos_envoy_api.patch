@@ -0,0 +1,122 @@
+syntax = "proto3";
+
+package envoy.config.filter.network.thrift_proxy.v2alpha1;
+
+import "envoy/config/filter/network/thrift_proxy/v2alpha1/route.proto";
+
+import "google/protobuf/any.proto";
+import "google/protobuf/struct.proto";
+

diff --git a/third_party/envoy-api/envoy/extensions/filters/http/adaptive_concurrency/v3/adaptive_concurrency.proto b/third_party/envoy-api/envoy/extensions/filters/http/adaptive_concurrency/v3/adaptive_concurrency.proto

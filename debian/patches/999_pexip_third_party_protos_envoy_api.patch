+// [#protodoc-title: CSRF]
+// Cross-Site Request Forgery :ref:`configuration overview <config_http_filters_csrf>`.
+// [#extension: envoy.filters.http.csrf]
+
+// CSRF filter config.
+message CsrfPolicy {
+  option (udpa.annotations.versioning).previous_message_type =

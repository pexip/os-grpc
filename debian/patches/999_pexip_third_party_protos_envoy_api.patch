diff --git a/third_party/envoy-api/contrib/envoy/extensions/private_key_providers/cryptomb/v3alpha/cryptomb.proto b/third_party/envoy-api/contrib/envoy/extensions/private_key_providers/cryptomb/v3alpha/cryptomb.proto

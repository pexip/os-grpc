+    // operators if they are set in the value template.
+    //
+    // Example: dynamically set a header with the local port
+    //
+    // .. code-block:: yaml
+    //
+    //    headers_to_add:
+    //    - header:
+    //        key: original_dst_port
+    //        value: "%DOWNSTREAM_LOCAL_PORT%"
+    //

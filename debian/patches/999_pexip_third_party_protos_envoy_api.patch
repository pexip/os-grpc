diff --git a/third_party/envoy-api/contrib/envoy/extensions/compression/qatzip/compressor/v3alpha/qatzip.proto b/third_party/envoy-api/contrib/envoy/extensions/compression/qatzip/compressor/v3alpha/qatzip.proto
